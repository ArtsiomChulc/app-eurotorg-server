generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int      @id @default(autoincrement())
  email          String   @unique
  name           String?  @map("name")
  lastName       String?  @map("last_name")
  region         String?  @map("region")
  role           UserRole @default(USER)
  hashedPassword String   @map("hashed_password")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Market {
  id Int @id @default(autoincrement())

  marketNumber  String
  address       String?
  operatingMode String? @map("operating_mode")
  region        String

  directorId Int?      @map("director_id")
  director   Director? @relation(fields: [directorId], references: [id])

  engineerId Int?      @map("engineer_id")
  engineer   Engineer? @relation(fields: [engineerId], references: [id])

  networks StoreNetworks?

  meterNumbers MeterNumber[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("markets")
}

model Director {
  id         Int     @id @default(autoincrement())
  firstName  String
  lastName   String
  middleName String?
  phone      String
  email      String  @unique

  markets Market[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("directors")
}

model Engineer {
  id         Int     @id @default(autoincrement())
  firstName  String
  lastName   String
  middleName String?
  phone      String?
  email      String? @unique

  markets Market[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("engineers")
}

model StoreNetworks {
  id Int @id @default(autoincrement())

  heating     HeatingType
  sewerage    SewerageType
  waterSupply WaterSupply

  installedCapacity String @map("installed_capacity")
  existingCapacity  String @map("existing_capacity")

  marketId Int    @unique @map("market_id")
  market   Market @relation(fields: [marketId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("store_networks")
}

model MeterNumber {
  id         Int    @id @default(autoincrement())
  nomination String
  number     String

  marketId Int    @map("market_id")
  market   Market @relation(fields: [marketId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("meter_numbers")
}

enum HeatingType {
  ELECTRO
  CENTRAL
  PEAT
  PELLET
  GAS
  NO
}

enum SewerageType {
  CENTRAL
  SEPTIC_TANK
  NO
}

enum WaterSupply {
  YES
  NO
}

enum UserRole {
  USER
  ENGINEER
  ADMIN
}
